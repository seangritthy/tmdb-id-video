{
  "name": "tmdb-id-video",
  "version": "1.0.23",
  "private": true,
  "description": "TMDB Video Player Extractor",
  "author": "seangritthy",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "start:termux": "next start -H 0.0.0.0 -p 5050",
    "lint": "next lint",
    "sb-start": "supabase start --debug --ignore-health-check",
    "sb-stop": "supabase stop --debug --all",
    "sb-restart": "supabase stop --debug --all && supabase start --debug --ignore-health-check",
    "sb-db-reset": "supabase db reset",
    "sb-db-types": "supabase gen types typescript --local > src/utils/supabase/types.ts",
    "cf:convert": "node -e \"import { rmSync } from 'node:fs'; rmSync('.vercel/output/static', { recursive: true, force: true });\" && npx @cloudflare/next-on-pages --skip-build",
    "cf:patch": "node scripts/patch-worker.cjs",
    "cf:deploy": "npx wrangler pages deploy .vercel/output/static --project-name=vdomov --branch=main",
    "deploy:cf": "npm run cf:convert && npm run cf:patch && npm run cf:deploy"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@heroui/react": "^2.8.3",
    "@hookform/resolvers": "^5.2.1",
    "@mantine/hooks": "^8.2.4",
    "@marsidev/react-turnstile": "^1.3.0",
    "@sparticuz/chromium-min": "^149.0.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.85.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "hls.js": "^1.6.16",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "puppeteer": "^25.3.0",
    "puppeteer-core": "^25.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-share": "^5.2.2",
    "string-ts": "^2.2.1",
    "tailwindcss-motion": "^1.1.1",
    "tmdb-ts": "^2.0.2",
    "use-long-press": "^3.3.0",
    "vaul": "^1.1.2",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@iconify/react": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tanstack/react-query-devtools": "^5.85.3",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.1",
    "next": "^16.2.10",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "typescript": "^5",
    "webpack": "^5.101.2",
    "wrangler": "^4.118.0"
  },
  "prettier": {
    "proseWrap": "never",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
